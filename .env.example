# NVIDIA NIM Speed Benchmark — configuration template.
# Copy to .env and fill in. Empty values fall back to the defaults in
# benchmark.py / ai_rating.py. Relative file paths stay in the project folder.

# API key from https://build.nvidia.com ("Get API Key") — required
NVIDIA_API_KEY=

# --- benchmark.py ---
BUILD=https://build.nvidia.com
API=https://integrate.api.nvidia.com/v1
MODELS_FILE=models.json
RESULTS_FILE=results.json
CACHE=mdcache
PROMPT=What is the capital of India? Please answer in one sentence.
# Per request in seconds. Free-tier models can need ~90s for the first token.
REQUEST_TIMEOUT=300
CHAT_PAUSE=12
OTHER_PAUSE=3
RETRY_BACKOFF=30

# --- ai_rating.py (reuses RESULTS_FILE from above) ---
# Judge for the AI ranking — it must answer with the requested JSON.
# Verified reachable + JSON-compliant on the free tier (measured 2026-11-06).
AI_JUDGE_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
JUDGE_TIMEOUT=180
JUDGE_PAUSE=5

# --- history (benchmark.py run snapshots) ---
# results_history.json — append-only list of past benchmark runs
HISTORY_FILE=results_history.json
# How many days back to keep (older runs are pruned on write)
HISTORY_RETENTION_DAYS=30
# Hard cap on number of runs kept (oldest dropped first)
MAX_HISTORY_RUNS=100
